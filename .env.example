# LLM - cheapest viable model; one pass per night
OPENAI_API_KEY=
HERMES_MODEL=gpt-4o-mini
HERMES_MAX_TOKENS_PER_RUN=1500
HERMES_MONTHLY_BUDGET_USD=1.00

# Runtime
HERMES_DATA_DIR=/data
HERMES_DIRECTIVES=/app/directives.yaml
HERMES_INSTINCT_ADDRESS=xt1udv@mail.instinct.com
TZ=America/New_York

# Outbound-only report mailbox owned by Hermes (use an app password; never commit .env)
# No IMAP here on purpose: Hermes cannot receive mail. Replies go to Instinct.
HERMES_EMAIL_ADDRESS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
