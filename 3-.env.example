# LLM
OPENAI_API_KEY=
HERMES_MODEL=gpt-4.1-mini

# Runtime starts read-only. Set active only after reviewing directives.yaml.
HERMES_MODE=readonly
HERMES_DATA_DIR=/data
HERMES_WORKSPACE=/workspace
HERMES_DIRECTIVES=/app/directives.yaml
HERMES_INSTINCT_ADDRESS=xt1udv@mail.instinct.com
HERMES_FALLBACK_MINUTES=30

# SMTP/IMAP mailbox owned by Hermes (use an app password, never commit .env)
HERMES_EMAIL_ADDRESS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Telegram bot made with BotFather; numeric Royce user ID is the only allowed controller
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Optional command allowlist for build-freely directives, comma-separated executables
HERMES_ALLOWED_COMMANDS=git,npm,npx,python,pytest,pip
